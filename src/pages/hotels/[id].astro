---
import PageLayout from '../../layouts/PageLayout.astro';
import hotelsData from '../../data/hotels.json';

export function getStaticPaths() {
  const allHotels = hotelsData as Record<string, any[]>;
  return Object.values(allHotels)
    .flat()
    .map((hotel) => ({
      params: { id: hotel.id },
      props: { hotel },
    }));
}

const { hotel } = Astro.props;

const googleMapsUrl = `https://www.google.com/maps/place/?q=place_id:${hotel.id}`;
const distanceText = hotel.distanceKm < 1
  ? `${Math.round(hotel.distanceKm * 1000)}m`
  : `${hotel.distanceKm.toFixed(1)}km`;

const priceLevelText = hotel.priceLevel ? '£'.repeat(hotel.priceLevel) : null;
const priceLevelLabel = ['', 'Budget', 'Moderate', 'Upscale', 'Luxury'][hotel.priceLevel ?? 0] ?? null;
---

<PageLayout
  title={`${hotel.name} — Hotels Near ${hotel.stadiumName} | StadiumStays`}
  description={hotel.description ?? `${hotel.name} is ${distanceText} from ${hotel.stadiumName}, home of ${hotel.clubName}. View details and check availability.`}
>
  <div class="container-wide py-12 lg:py-16">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-zinc-500 mb-8 flex-wrap" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-300 transition-colors">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/clubs/" class="hover:text-zinc-300 transition-colors">Clubs</a>
      <span aria-hidden="true">/</span>
      <a href={`/clubs/${hotel.clubSlug}/`} class="hover:text-zinc-300 transition-colors">{hotel.clubName}</a>
      <span aria-hidden="true">/</span>
      <span class="text-zinc-300">{hotel.name}</span>
    </nav>

    <div class="lg:grid lg:grid-cols-3 lg:gap-10">

      <!-- Main content -->
      <div class="lg:col-span-2">

        <!-- Photo gallery -->
        {hotel.photos?.length > 0 ? (
          <div class={`grid gap-2 mb-8 rounded-xl overflow-hidden ${hotel.photos.length > 1 ? 'grid-cols-2' : 'grid-cols-1'}`}>
            <img
              src={hotel.photos[0]}
              alt={hotel.name}
              class={`w-full object-cover ${hotel.photos.length > 1 ? 'row-span-2 h-72 sm:h-96' : 'h-64 sm:h-80'}`}
              loading="eager"
            />
            {hotel.photos[1] && (
              <img
                src={hotel.photos[1]}
                alt={`${hotel.name} — photo 2`}
                class="w-full h-[138px] sm:h-[184px] object-cover"
                loading="lazy"
              />
            )}
            {hotel.photos[2] && (
              <img
                src={hotel.photos[2]}
                alt={`${hotel.name} — photo 3`}
                class="w-full h-[138px] sm:h-[184px] object-cover"
                loading="lazy"
              />
            )}
          </div>
        ) : (
          <div class="w-full h-64 bg-zinc-800 rounded-xl flex items-center justify-center mb-8">
            <svg class="w-16 h-16 text-zinc-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
        )}

        <!-- Hotel name + rating -->
        <div class="mb-6">
          <div class="flex flex-wrap items-center gap-3 mb-3">
            {priceLevelText && (
              <span class="badge bg-zinc-800 text-zinc-300 border border-zinc-700/50 font-medium">
                {priceLevelText} · {priceLevelLabel}
              </span>
            )}
            <span class="badge bg-zinc-800 text-zinc-400 border border-zinc-700/50">
              <svg class="w-3 h-3 mr-1 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {distanceText} from {hotel.stadiumName}
            </span>
          </div>

          <h1 class="text-3xl lg:text-4xl font-bold text-white mb-3">{hotel.name}</h1>

          {hotel.rating && (
            <div class="flex items-center gap-2">
              <span class="text-2xl font-bold text-white">{hotel.rating.toFixed(1)}</span>
              <div class="flex items-center gap-0.5">
                {Array.from({ length: 5 }, (_, i) => (
                  <svg
                    class:list={['w-4 h-4', i < Math.round(hotel.rating) ? 'text-amber-400' : 'text-zinc-700']}
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                ))}
              </div>
              {hotel.reviewCount && (
                <span class="text-zinc-400 text-sm">({hotel.reviewCount.toLocaleString()} reviews)</span>
              )}
            </div>
          )}
        </div>

        <!-- Description -->
        {hotel.description && (
          <div class="card p-6 mb-6">
            <p class="text-zinc-300 leading-relaxed">{hotel.description}</p>
          </div>
        )}

        <!-- Location details -->
        <div class="card p-6 mb-6">
          <h2 class="font-semibold text-white mb-4">Location</h2>
          <div class="space-y-3">
            {hotel.address && (
              <div class="flex gap-3">
                <svg class="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <address class="text-zinc-300 text-sm not-italic">{hotel.address}</address>
              </div>
            )}
            <div class="flex gap-3">
              <svg class="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" />
              </svg>
              <span class="text-zinc-300 text-sm">{distanceText} from {hotel.stadiumName}</span>
            </div>
            {hotel.website && (
              <div class="flex gap-3">
                <svg class="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
                <a
                  href={hotel.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-emerald-400 text-sm hover:underline truncate"
                >
                  {hotel.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                </a>
              </div>
            )}
          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="mt-8 lg:mt-0">

        <!-- Book CTA -->
        <div class="card p-6 mb-6 sticky top-6">
          <h2 class="font-semibold text-white mb-1">Check Availability</h2>
          <p class="text-zinc-400 text-sm mb-5">
            View live prices and book via Google Hotels — compares Booking.com, Expedia and more.
          </p>

          {hotel.rating && (
            <div class="flex items-center gap-2 mb-5 pb-5 border-b border-zinc-800">
              <span class="text-3xl font-bold text-white">{hotel.rating.toFixed(1)}</span>
              <div>
                <div class="text-sm font-medium text-white">
                  {hotel.rating >= 4.5 ? 'Exceptional' : hotel.rating >= 4.0 ? 'Very Good' : hotel.rating >= 3.5 ? 'Good' : 'Fair'}
                </div>
                {hotel.reviewCount && (
                  <div class="text-xs text-zinc-500">{hotel.reviewCount.toLocaleString()} Google reviews</div>
                )}
              </div>
            </div>
          )}

          <a
            href={googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary w-full justify-center text-base py-3"
          >
            Book Now
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>

          <p class="text-zinc-600 text-xs mt-3 text-center">Opens Google Hotels to compare prices</p>
        </div>

        <!-- Back to club -->
        <a
          href={`/clubs/${hotel.clubSlug}/`}
          class="card p-5 hover:border-zinc-700 transition-colors block group"
        >
          <div class="flex items-center justify-between">
            <div>
              <div class="text-xs text-zinc-500 mb-1">More hotels near</div>
              <div class="font-semibold text-white group-hover:text-emerald-400 transition-colors">{hotel.stadiumName}</div>
              <div class="text-zinc-500 text-xs mt-1">{hotel.clubName}</div>
            </div>
            <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>

      </aside>
    </div>
  </div>
</PageLayout>
