---
import PageLayout from '../../layouts/PageLayout.astro';
import CityGuideContent from '../../components/CityGuideContent.astro';
import fixtures from '../../data/fixtures.json';
import clubs from '../../data/clubs.json';
import cities from '../../data/cities.json';
import hotels from '../../data/hotels.json';
import unsplashImages from '../../data/unsplash-images.json';

export function getStaticPaths() {
  const toSlug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const seen = new Set<string>();
  const paths: { params: { slug: string }; props: { fixture: any } }[] = [];
  for (const f of fixtures) {
    const homeSlug = f.homeSlug ?? toSlug(f.homeTeam);
    const awaySlug = f.awaySlug ?? toSlug(f.awayTeam);
    const slug = `${homeSlug}-vs-${awaySlug}-${f.date.substring(0, 10)}`;
    if (seen.has(slug)) continue;
    seen.add(slug);
    paths.push({ params: { slug }, props: { fixture: f } });
  }
  return paths;
}

const { fixture } = Astro.props;

// ── Lookup data ──────────────────────────────────────────────────────────────
const homeClub  = fixture.homeSlug ? (clubs as any[]).find((c: any) => c.slug === fixture.homeSlug) ?? null : null;
const homeCity  = homeClub ? (cities as any[]).find((c: any) => c.slug === homeClub.city) ?? null : null;

// City clubs for the city guide section (UK clubs only on fixture pages)
const cityClubs = homeCity
  ? (clubs as any[]).filter((c: any) => c.city === homeCity.slug)
  : [];

const homeHotels: any[] = fixture.homeSlug ? ((hotels as any)[fixture.homeSlug] ?? []) : [];
const topHotels = [...homeHotels]
  .sort((a, b) => (b.rating ?? 0) - (a.rating ?? 0))
  .slice(0, 10);

// ── Date formatting ──────────────────────────────────────────────────────────
const kickoffDate = new Date(fixture.date);
const formattedDate = kickoffDate.toLocaleDateString('en-GB', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
  timeZone: 'Europe/London',
});
const formattedTime = kickoffDate.toLocaleTimeString('en-GB', {
  hour: '2-digit', minute: '2-digit', timeZone: 'Europe/London',
});
const shortDate = kickoffDate.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/London',
});

// ── Meta ─────────────────────────────────────────────────────────────────────
const metaTitle = `${fixture.awayTeam} vs ${fixture.homeTeam} Hotels & Travel Guide | ${shortDate}`;
const metaDesc  = `Where to stay for ${fixture.awayTeam} vs ${fixture.homeTeam} on ${shortDate}. Hotels near ${fixture.venue ?? fixture.homeTeam + ' stadium'}, getting there, pre-match pubs and a weekend city break guide.`;

// ── Hero image ───────────────────────────────────────────────────────────────
const imgs = unsplashImages as Record<string, any>;
const cityHeroImg = homeCity ? (imgs[homeCity.slug] ?? null) : null;

// Price level symbols
function priceSymbol(level: number | string | null) {
  if (!level) return '';
  if (typeof level === 'number') return '£'.repeat(Math.min(level, 4));
  const map: Record<string, string> = {
    PRICE_LEVEL_INEXPENSIVE: '£',
    PRICE_LEVEL_MODERATE: '££',
    PRICE_LEVEL_EXPENSIVE: '£££',
    PRICE_LEVEL_VERY_EXPENSIVE: '££££',
  };
  return map[level] ?? '';
}
---

<PageLayout title={metaTitle} description={metaDesc}>

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="bg-zinc-950 border-b border-zinc-800 pt-12 pb-16">
    <div class="container-narrow text-center">

      <!-- League badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm font-medium mb-6">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/></svg>
        Premier League · Match Day Travel Guide
      </div>

      <!-- Teams -->
      <div class="flex items-center justify-center gap-4 sm:gap-8 mb-6">
        <!-- Away team (visiting) -->
        <div class="flex-1 min-w-0 text-right">
          {fixture.awaySlug ? (
            <a href={`/clubs/${fixture.awaySlug}/`} class="text-xl sm:text-4xl font-bold text-white hover:text-emerald-400 transition-colors leading-tight block break-words">
              {fixture.awayTeam}
            </a>
          ) : (
            <span class="text-xl sm:text-4xl font-bold text-white leading-tight block break-words">{fixture.awayTeam}</span>
          )}
          <span class="text-zinc-500 text-xs sm:text-sm mt-1 block">Away</span>
        </div>

        <div class="flex-shrink-0 text-center">
          <div class="w-10 h-10 sm:w-16 sm:h-16 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center text-zinc-400 font-bold text-sm sm:text-xl">
            vs
          </div>
        </div>

        <!-- Home team -->
        <div class="flex-1 min-w-0 text-left">
          {fixture.homeSlug ? (
            <a href={`/clubs/${fixture.homeSlug}/`} class="text-xl sm:text-4xl font-bold text-white hover:text-emerald-400 transition-colors leading-tight block break-words">
              {fixture.homeTeam}
            </a>
          ) : (
            <span class="text-xl sm:text-4xl font-bold text-white leading-tight block break-words">{fixture.homeTeam}</span>
          )}
          <span class="text-zinc-500 text-xs sm:text-sm mt-1 block">Home</span>
        </div>
      </div>

      <!-- Match details -->
      <div class="flex flex-wrap items-center justify-center gap-4 text-sm">
        <span class="flex items-center gap-1.5 text-zinc-300">
          <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          {formattedDate}
        </span>
        <span class="flex items-center gap-1.5 text-zinc-300">
          <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Kick-off {formattedTime}
        </span>
        {fixture.venue && (
          <span class="flex items-center gap-1.5 text-zinc-300">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            {fixture.venue}{fixture.venueCity ? `, ${fixture.venueCity}` : ''}
          </span>
        )}
      </div>
    </div>
  </section>

  <!-- ── Page body ─────────────────────────────────────────────────────────── -->
  <div class="container-wide py-12 lg:py-16">
    <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">

      <!-- Main content (2/3 width) -->
      <div class="lg:col-span-2 space-y-14">

        <!-- ── City hero image ────────────────────────────────────────────── -->
        {homeCity && cityHeroImg && (
          <section>
            <div class="rounded-xl overflow-hidden relative">
              <img
                src={cityHeroImg.url}
                alt={cityHeroImg.altDescription || `${homeCity.name} city`}
                class="w-full h-56 sm:h-72 object-cover"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />
              <div class="absolute bottom-0 left-0 p-4">
                <p class="text-white font-semibold text-lg">Your weekend in {homeCity.name}</p>
                <p class="text-zinc-300 text-sm">{homeCity.description}</p>
              </div>
              {cityHeroImg.photographer && (
                <p class="absolute bottom-0 right-0 bg-black/60 text-white/60 text-[10px] px-3 py-1.5">
                  <a
                    href={`https://unsplash.com/@${cityHeroImg.photographerUsername}?utm_source=stadiumstays&utm_medium=referral`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-white"
                  >{cityHeroImg.photographer}</a> / Unsplash
                </p>
              )}
            </div>
          </section>
        )}

        <!-- ── Getting There ──────────────────────────────────────────────── -->
        <section>
          <h2 class="section-title mb-2">Getting There</h2>
          <p class="section-subtitle mb-6">As an away fan travelling to {fixture.venueCity ?? fixture.homeTeam}</p>

          {homeClub?.travelTips ? (
            <div class="space-y-4">
              <div class="card p-5">
                <p class="text-zinc-300 leading-relaxed">{homeClub.travelTips}</p>
              </div>
              {homeCity && (
                <div class="grid sm:grid-cols-2 gap-4">
                  {homeCity.airports?.length && (
                    <div class="card p-4">
                      <h3 class="text-white font-semibold mb-2 flex items-center gap-2">
                        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                        Flying in
                      </h3>
                      <ul class="space-y-1">
                        {homeCity.airports.map((a: string) => (
                          <li class="text-zinc-400 text-sm">· {a}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {homeCity.mainStation && (
                    <div class="card p-4">
                      <h3 class="text-white font-semibold mb-2 flex items-center gap-2">
                        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        By train
                      </h3>
                      <p class="text-zinc-400 text-sm">{homeCity.mainStation}</p>
                    </div>
                  )}
                </div>
              )}
            </div>
          ) : (
            <div class="card p-5">
              <p class="text-zinc-400 leading-relaxed">
                {fixture.venue ? `${fixture.venue} is located in ${fixture.venueCity ?? 'the host city'}.` : ''}
                {homeCity?.mainStation ? ` The nearest major rail terminal is ${homeCity.mainStation}.` : ''}
                {homeCity?.airports?.length ? ` Airports serving the area include ${homeCity.airports.slice(0,2).join(' and ')}.` : ''}
                {!homeCity ? ` Check National Rail or Google Maps for the best route from your departure point.` : ''}
              </p>
            </div>
          )}
        </section>

        <!-- ── Where to Stay ──────────────────────────────────────────────── -->
        <section>
          <h2 class="section-title mb-2">Where to Stay</h2>
          <p class="section-subtitle mb-6">
            Top-rated hotels near {fixture.venue ?? `${fixture.homeTeam}'s stadium`}
            {homeClub?.city && homeCity ? ` in ${homeCity.name}` : ''}
          </p>

          {topHotels.length > 0 ? (
            <div class="space-y-3">
              {topHotels.map((hotel: any, i: number) => (
                <div class="card p-3 sm:p-4 flex items-center gap-3 sm:gap-4">
                  <div class="flex-shrink-0 w-16 h-16 sm:w-20 sm:h-20 rounded-lg overflow-hidden bg-zinc-800">
                    <img
                      src={hotel.photos?.[0] ?? `https://picsum.photos/seed/${hotel.id}/200/200`}
                      alt={hotel.name}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-start gap-2 flex-wrap">
                      <h3 class="font-semibold text-white leading-tight text-sm sm:text-base">
                        {hotel.website ? (
                          <a href={hotel.website} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors">
                            {hotel.name}
                          </a>
                        ) : hotel.name}
                      </h3>
                      {i === 0 && <span class="text-[10px] font-bold bg-emerald-500/20 text-emerald-400 px-1.5 py-0.5 rounded uppercase tracking-wider">Top rated</span>}
                    </div>
                    {hotel.address && <p class="text-zinc-500 text-xs mt-0.5 truncate">{hotel.address}</p>}
                    <div class="flex items-center gap-3 mt-1 flex-wrap">
                      {hotel.rating && (
                        <span class="text-sm text-zinc-300">
                          ★ <span class="font-medium">{hotel.rating}</span>
                          {hotel.reviewCount && <span class="text-zinc-500"> ({hotel.reviewCount.toLocaleString()})</span>}
                        </span>
                      )}
                      {hotel.priceLevel && <span class="text-zinc-500 text-sm">{priceSymbol(hotel.priceLevel)}</span>}
                      {hotel.distanceKm && <span class="text-zinc-600 text-xs">{hotel.distanceKm.toFixed(1)} km from stadium</span>}
                    </div>
                  </div>
                  {fixture.homeSlug && (
                    <a
                      href={`/hotels/${hotel.id}/`}
                      class="flex-shrink-0 text-xs text-emerald-400 hover:text-emerald-300 border border-emerald-500/30 hover:border-emerald-500/60 rounded px-2 py-1.5 transition-colors whitespace-nowrap"
                    >
                      View →
                    </a>
                  )}
                </div>
              ))}
              {fixture.homeSlug && (
                <div class="text-center pt-2">
                  <a href={`/clubs/${fixture.homeSlug}/`} class="text-emerald-400 hover:text-emerald-300 text-sm font-medium transition-colors">
                    See all hotels near {fixture.homeTeam} →
                  </a>
                </div>
              )}
            </div>
          ) : (
            <div class="card p-6 text-center">
              <p class="text-zinc-500">We're still adding hotel data for this stadium.</p>
              {homeCity && (
                <a
                  href={`https://www.google.com/maps/search/hotels+near+${encodeURIComponent(fixture.venue ?? fixture.homeTeam)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex btn-secondary text-sm"
                >
                  Search on Google Maps
                </a>
              )}
            </div>
          )}
        </section>

        <!-- ── Pre-Match ──────────────────────────────────────────────────── -->
        <section>
          <h2 class="section-title mb-2">Pre-Match</h2>
          <p class="section-subtitle mb-6">Pubs, food & tips for away fans near {fixture.venue ?? `${fixture.homeTeam}'s ground`}</p>

          {homeClub?.matchDayTips?.length ? (
            <ul class="space-y-3">
              {(Array.isArray(homeClub.matchDayTips) ? homeClub.matchDayTips as string[] : String(homeClub.matchDayTips).split('\n').filter(Boolean)).map((tip: string) => (
                <li class="card p-4 flex gap-3">
                  <span class="text-emerald-400 mt-0.5 flex-shrink-0">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  </span>
                  <p class="text-zinc-300 text-sm leading-relaxed">{tip}</p>
                </li>
              ))}
            </ul>
          ) : (
            <div class="card p-5">
              <p class="text-zinc-400 leading-relaxed">
                Arrive early if you're an away fan — check with your club's supporters' trust for any designated away fan pubs.
                {homeCity && ` ${homeCity.name} has a great range of bars and restaurants if you make a day of it.`}
              </p>
            </div>
          )}
        </section>

        <!-- ── City Guide ─────────────────────────────────────────────────── -->
        {homeCity && (
          <div class="space-y-14 pt-4 border-t border-zinc-800">
            <div>
              <h2 class="section-title mb-1">{homeCity.name} City Guide</h2>
              <p class="section-subtitle">
                Everything you need to know about {homeCity.name} for your visit
                — <a href={`/cities/${homeCity.slug}/`} class="text-emerald-400 hover:text-emerald-300 transition-colors">view full guide →</a>
              </p>
            </div>
            <CityGuideContent city={homeCity} cityClubs={cityClubs} unsplashImages={imgs} />
          </div>
        )}

      </div><!-- /main -->

      <!-- ── Sidebar ────────────────────────────────────────────────────────── -->
      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">

        <!-- Quick info card -->
        <div class="card p-5">
          <h3 class="font-bold text-white mb-4">Match Info</h3>
          <dl class="space-y-3 text-sm">
            <div>
              <dt class="text-zinc-500 text-xs uppercase tracking-wider mb-0.5">Date</dt>
              <dd class="text-zinc-200">{formattedDate}</dd>
            </div>
            <div>
              <dt class="text-zinc-500 text-xs uppercase tracking-wider mb-0.5">Kick-off</dt>
              <dd class="text-zinc-200">{formattedTime} (UK)</dd>
            </div>
            {fixture.venue && (
              <div>
                <dt class="text-zinc-500 text-xs uppercase tracking-wider mb-0.5">Venue</dt>
                <dd class="text-zinc-200">{fixture.venue}</dd>
              </div>
            )}
            {fixture.venueCity && (
              <div>
                <dt class="text-zinc-500 text-xs uppercase tracking-wider mb-0.5">City</dt>
                <dd class="text-zinc-200">{fixture.venueCity}</dd>
              </div>
            )}
            {homeClub?.stadiumCapacity && (
              <div>
                <dt class="text-zinc-500 text-xs uppercase tracking-wider mb-0.5">Capacity</dt>
                <dd class="text-zinc-200">{homeClub.stadiumCapacity.toLocaleString()}</dd>
              </div>
            )}
          </dl>

          <div class="mt-5 pt-4 border-t border-zinc-800 space-y-2">
            {fixture.homeSlug && (
              <a href={`/clubs/${fixture.homeSlug}/`} class="block text-sm text-emerald-400 hover:text-emerald-300 transition-colors">
                → {fixture.homeTeam} stadium guide
              </a>
            )}
            {fixture.awaySlug && (
              <a href={`/clubs/${fixture.awaySlug}/`} class="block text-sm text-emerald-400 hover:text-emerald-300 transition-colors">
                → {fixture.awayTeam} club page
              </a>
            )}
            {homeCity && (
              <a href={`/cities/${homeCity.slug}/`} class="block text-sm text-emerald-400 hover:text-emerald-300 transition-colors">
                → {homeCity.name} city guide
              </a>
            )}
            <a href="/fixtures/" class="block text-sm text-zinc-500 hover:text-zinc-300 transition-colors">
              ← All fixtures
            </a>
          </div>
        </div>

        <!-- Hotels CTA -->
        {fixture.homeSlug && topHotels.length > 0 && (
          <div class="card p-5 bg-emerald-500/5 border-emerald-500/20">
            <h3 class="font-bold text-white mb-2">Book your stay</h3>
            <p class="text-zinc-400 text-sm mb-4">
              {topHotels.length} hotels listed near {fixture.venue ?? `${fixture.homeTeam}'s stadium`}. Sort by distance, price, or rating.
            </p>
            <a href={`/clubs/${fixture.homeSlug}/`} class="btn-primary w-full justify-center text-sm">
              Browse hotels
            </a>
          </div>
        )}

      </aside>
    </div>
  </div>

</PageLayout>
