---
import PageLayout from '../../layouts/PageLayout.astro';
import CityGuideContent from '../../components/CityGuideContent.astro';
import cities from '../../data/cities.json';
import clubs from '../../data/clubs.json';
import clubsEurope from '../../data/clubs-europe.json';
import unsplashImages from '../../data/unsplash-images.json';

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const ukClubs = clubs.filter((c) => c.city === city.slug);
const euClubs = (clubsEurope as any[])
  .filter((c: any) => c.citySlug === city.slug && (c.leagueSlug === 'la-liga' || c.leagueSlug === 'serie-a'))
  .map((c: any) => ({
    slug: c.slug,
    name: c.name,
    stadium: c.stadium,
    city: c.citySlug,
    league: c.leagueSlug,
    stadiumCapacity: c.capacity ?? 0,
  }));
const cityClubs = [...ukClubs, ...euClubs];
const heroImage = (unsplashImages as Record<string, any>)[city.slug] ?? null;
const imgs = unsplashImages as Record<string, any>;
---

<PageLayout
  title={`${city.name} Football Hotels & Match Day Guide | StadiumStays`}
  description={`The complete football fan's guide to ${city.name}: best areas to stay, pre-match pubs, restaurants, getting there, and things to do beyond the match.`}
>
  <div class="container-wide py-12 lg:py-16">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-zinc-500 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-300 transition-colors">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/cities/" class="hover:text-zinc-300 transition-colors">Cities</a>
      <span aria-hidden="true">/</span>
      <span class="text-zinc-300">{city.name}</span>
    </nav>

    <!-- City hero image -->
    {heroImage && (
      <div class="mb-10 rounded-2xl overflow-hidden relative">
        <img
          src={heroImage.url}
          alt={heroImage.altDescription || `${city.name} city`}
          class="w-full h-64 sm:h-80 lg:h-96 object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />
        <div class="absolute bottom-0 left-0 p-6">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs font-semibold tracking-widest uppercase text-emerald-400">{city.country}</span>
            {cityClubs.length > 0 && (
              <span class="text-xs text-zinc-400">{cityClubs.length} {cityClubs.length === 1 ? 'club' : 'clubs'}</span>
            )}
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white">{city.name}</h1>
          <p class="text-zinc-300 mt-2 text-base max-w-xl">{city.description}</p>
        </div>
        {heroImage.photographer && (
          <p class="absolute bottom-0 right-0 bg-black/60 text-white/60 text-[10px] px-3 py-1.5">
            <a
              href={`https://unsplash.com/@${heroImage.photographerUsername}?utm_source=stadiumstays&utm_medium=referral`}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white"
            >{heroImage.photographer}</a> / Unsplash
          </p>
        )}
      </div>
    )}

    <div class="lg:grid lg:grid-cols-3 lg:gap-12">

      <!-- ── Main content ──────────────────────────────────────────────────── -->
      <div class="lg:col-span-2 space-y-14">
        <CityGuideContent city={city} cityClubs={cityClubs} unsplashImages={imgs} />
      </div><!-- /main -->

      <!-- ── Sidebar ────────────────────────────────────────────────────────── -->
      <aside class="mt-14 lg:mt-0 space-y-6 lg:sticky lg:top-24 lg:self-start">

        <!-- Quick reference -->
        <div class="card p-5">
          <h3 class="font-bold text-white mb-4 text-sm uppercase tracking-wider">Travel Essentials</h3>
          <dl class="space-y-4 text-sm">
            {city.airports?.length > 0 && (
              <div>
                <dt class="text-zinc-500 text-xs uppercase tracking-wider mb-1.5">Airports</dt>
                <dd>
                  <ul class="space-y-1">
                    {city.airports.map((a: string) => (
                      <li class="text-zinc-300 flex items-start gap-1.5">
                        <span class="text-emerald-500 mt-0.5 flex-shrink-0">✈</span>
                        <span class="break-words">{a}</span>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
            {city.mainStation && (
              <div>
                <dt class="text-zinc-500 text-xs uppercase tracking-wider mb-1">Main Station</dt>
                <dd class="text-zinc-300">🚂 {city.mainStation}</dd>
              </div>
            )}
          </dl>
        </div>

        <!-- Clubs quick links -->
        {cityClubs.length > 0 && (
          <div class="card p-5">
            <h3 class="font-bold text-white mb-3 text-sm uppercase tracking-wider">Find Hotels Near</h3>
            <div class="space-y-2">
              {cityClubs.map((club) => (
                <a
                  href={`/clubs/${club.slug}/`}
                  class="flex items-center justify-between p-3 rounded-lg bg-zinc-800/50 hover:bg-zinc-800 border border-transparent hover:border-zinc-700 transition-all group"
                >
                  <div class="min-w-0">
                    <div class="text-sm font-medium text-white group-hover:text-emerald-400 transition-colors truncate">{club.name}</div>
                    <div class="text-xs text-zinc-500 truncate">{club.stadium}</div>
                  </div>
                  <svg class="w-4 h-4 text-zinc-600 group-hover:text-emerald-400 transition-colors flex-shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- All cities link -->
        <a href="/cities/" class="block text-sm text-zinc-500 hover:text-zinc-300 transition-colors text-center">
          ← All city guides
        </a>

      </aside>
    </div>
  </div>
</PageLayout>
