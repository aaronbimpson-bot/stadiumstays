---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Page Not Found — StadiumStays"
  description="The page you're looking for doesn't exist."
  noIndex={true}
>
  <div class="container-narrow py-24 lg:py-32 text-center">
    <div class="text-8xl font-bold text-zinc-800 mb-6 font-mono">404</div>
    <h1 class="text-3xl font-bold text-white mb-4">Page Not Found</h1>
    <p class="text-zinc-400 mb-10 max-w-md mx-auto">
      We couldn't find the page you're looking for. It may have moved or been removed.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/" class="btn-primary">Back to Home</a>
      <a href="/clubs/" class="btn-secondary">Browse Clubs</a>
    </div>
  </div>
</PageLayout>
