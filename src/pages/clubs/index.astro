---
import PageLayout from '../../layouts/PageLayout.astro';
import ClubCard from '../../components/ClubCard.astro';
import clubs from '../../data/clubs.json';
import leagues from '../../data/leagues.json';
import unsplashImages from '../../data/unsplash-images.json';

const leagueLabels: Record<string, string> = Object.fromEntries(
  leagues.map(l => [l.slug, l.name])
);

// Group clubs by league
const clubsByLeague = leagues.map(league => ({
  league,
  clubs: clubs.filter(c => c.league === league.slug),
})).filter(g => g.clubs.length > 0);
---

<PageLayout
  title="All Clubs — Hotels Near Every Stadium"
  description="Find hotels near every football club in the UK. Browse all Premier League, Championship, and Scottish Premiership clubs."
>
  <div class="container-wide py-12 lg:py-16">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-zinc-500 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-300 transition-colors">Home</a>
      <span aria-hidden="true">/</span>
      <span class="text-zinc-300">Clubs</span>
    </nav>

    <div class="mb-10">
      <h1 class="section-title text-3xl lg:text-4xl mb-3">All Clubs</h1>
      <p class="section-subtitle text-base">Hotels near every football stadium in the UK</p>
    </div>

    {clubsByLeague.map(({ league, clubs: leagueClubs }) => (
      <div class="mb-14">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-3">
            <h2 class="text-xl font-bold text-white">{league.name}</h2>
            <span class="badge bg-zinc-800 text-zinc-500 border border-zinc-700/50">{league.country}</span>
          </div>
          <a
            href={`/leagues/${league.slug}/`}
            class="text-emerald-400 hover:text-emerald-300 text-sm font-medium transition-colors"
          >
            League guide →
          </a>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          {leagueClubs.map((club) => {
            const img = (unsplashImages as Record<string, any>)[club.slug];
            return (
              <ClubCard
                slug={club.slug}
                name={club.name}
                stadium={club.stadium}
                city={club.city}
                league={club.league}
                stadiumCapacity={club.stadiumCapacity}
                imageUrl={img?.url}
                imageAlt={img?.altDescription}
                photographer={img?.photographer}
                photographerUsername={img?.photographerUsername}
              />
            );
          })}
        </div>
      </div>
    ))}
  </div>
</PageLayout>
