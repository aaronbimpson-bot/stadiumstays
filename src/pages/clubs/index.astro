---
import PageLayout from '../../layouts/PageLayout.astro';
import ClubCard from '../../components/ClubCard.astro';
import clubs from '../../data/clubs.json';
import clubsEurope from '../../data/clubs-europe.json';
import leagues from '../../data/leagues.json';
import unsplashImages from '../../data/unsplash-images.json';

// European clubs that have hotel data (La Liga + Serie A)
const europeanClubs = (clubsEurope as any[])
  .filter((c: any) => c.leagueSlug === 'la-liga' || c.leagueSlug === 'serie-a')
  .map((c: any) => ({
    slug: c.slug,
    name: c.name,
    stadium: c.stadium,
    city: c.city ?? c.leagueSlug,
    citySlug: c.citySlug,
    league: c.leagueSlug,
    stadiumCapacity: c.capacity ?? null,
  }));

// All clubs combined, excluding Championship
const allClubs: any[] = [
  ...clubs.filter((c: any) => c.league !== 'championship'),
  ...europeanClubs,
];

// League display names (add European leagues not in leagues.json)
const leagueLabels: Record<string, string> = {
  ...Object.fromEntries(leagues.map(l => [l.slug, l.name])),
  'la-liga': 'La Liga',
  'serie-a': 'Serie A',
};

// Group by league — UK leagues first (no Championship), then European
const leagueOrder = [...leagues.map(l => l.slug).filter(s => s !== 'championship'), 'la-liga', 'serie-a'];
const clubsByLeague = leagueOrder
  .map(slug => ({
    leagueSlug: slug,
    leagueName: leagueLabels[slug] ?? slug,
    clubs: allClubs.filter(c => c.league === slug),
  }))
  .filter(g => g.clubs.length > 0);
---

<PageLayout
  title="All Clubs — Hotels Near Every Stadium"
  description="Find hotels near football clubs across the UK, Spain and Italy. Browse Premier League, La Liga, Serie A and Scottish Premiership clubs."
>
  <div class="container-wide py-12 lg:py-16">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-zinc-500 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-300 transition-colors">Home</a>
      <span aria-hidden="true">/</span>
      <span class="text-zinc-300">Clubs</span>
    </nav>

    <div class="mb-10">
      <h1 class="section-title text-3xl lg:text-4xl mb-3">All Clubs</h1>
      <p class="section-subtitle text-base">Hotels near {allClubs.length} football stadiums across the UK, Spain and Italy</p>
    </div>

    {clubsByLeague.map(({ leagueSlug, leagueName, clubs: leagueClubs }) => (
      <div class="mb-14">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-3">
            <h2 class="text-xl font-bold text-white">{leagueName}</h2>
          </div>
          {leagues.some(l => l.slug === leagueSlug) && (
            <a
              href={`/leagues/${leagueSlug}/`}
              class="text-emerald-400 hover:text-emerald-300 text-sm font-medium transition-colors"
            >
              League guide →
            </a>
          )}
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          {leagueClubs.map((club) => {
            const img = (unsplashImages as any)[club.slug + '-stadium']
                     ?? (unsplashImages as any)[club.slug]
                     ?? (unsplashImages as any)[club.citySlug]
                     ?? (unsplashImages as any)[club.city];
            return (
              <ClubCard
                slug={club.slug}
                name={club.name}
                stadium={club.stadium}
                city={club.city}
                league={club.league}
                stadiumCapacity={club.stadiumCapacity}
                imageUrl={img?.url}
                imageAlt={img?.altDescription}
                photographer={img?.photographer}
                photographerUsername={img?.photographerUsername}
              />
            );
          })}
        </div>
      </div>
    ))}
  </div>
</PageLayout>
