---
interface Props {
  slug: string;
  name: string;
  country: string;
  description: string;
  clubCount: number;
}

const { slug, name, country, description, clubCount } = Astro.props;

// Gradient palette keyed by country
const gradients: Record<string, string> = {
  'England':  'from-blue-900 via-blue-950 to-indigo-950',
  'Scotland': 'from-indigo-900 via-indigo-950 to-blue-950',
  'Spain':    'from-red-900 via-rose-950 to-red-950',
  'Italy':    'from-emerald-900 via-green-950 to-teal-950',
  'Germany':  'from-yellow-900 via-amber-950 to-stone-950',
  'France':   'from-blue-900 via-blue-950 to-sky-950',
};
const gradient = gradients[country] ?? 'from-zinc-800 via-zinc-900 to-zinc-950';

// First letter of the city name for the large background letter
const initial = name.charAt(0).toUpperCase();
---

<a href={`/cities/${slug}/`} class="card group hover:border-zinc-700 transition-all hover:-translate-y-0.5 block">
  <!-- Visual banner -->
  <div class={`relative aspect-[16/9] bg-gradient-to-br ${gradient} overflow-hidden`}>
    <!-- Large faded city initial -->
    <span
      class="absolute inset-0 flex items-center justify-center text-[9rem] font-black text-white/5 select-none leading-none"
      aria-hidden="true"
    >{initial}</span>
    <!-- City name overlay -->
    <div class="absolute inset-0 flex flex-col items-start justify-end p-4">
      <span class="text-xs font-semibold tracking-widest uppercase text-white/40 mb-1">{country}</span>
      <span class="text-xl font-bold text-white/80 leading-tight">{name}</span>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-8 bg-gradient-to-t from-zinc-900/60 to-transparent" aria-hidden="true"></div>
  </div>

  <div class="p-5">
    <div class="flex items-start justify-between mb-2">
      <div>
        <h3 class="font-bold text-white text-xl group-hover:text-emerald-400 transition-colors">{name}</h3>
        <p class="text-zinc-500 text-sm">{country}</p>
      </div>
      <span class="badge bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
        {clubCount} {clubCount === 1 ? 'club' : 'clubs'}
      </span>
    </div>

    <p class="text-zinc-400 text-sm leading-relaxed line-clamp-2">{description}</p>

    <div class="mt-4 flex items-center text-emerald-400 text-sm font-medium group-hover:underline">
      Explore hotels
      <svg class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </div>
  </div>
</a>
