---
interface Props {
  slug: string;
  name: string;
  stadium: string;
  city: string;
  league: string;
  stadiumCapacity: number;
  imageUrl?: string;
}

const { slug, name, stadium, city, league, stadiumCapacity, imageUrl } = Astro.props;

const leagueLabels: Record<string, string> = {
  'premier-league': 'Premier League',
  'championship': 'Championship',
  'league-one': 'League One',
  'scottish-premiership': 'Scottish Premiership',
};
---

<a href={`/clubs/${slug}/`} class="card group hover:border-zinc-700 transition-all hover:-translate-y-0.5 block">
  <!-- Image area -->
  <div class="relative aspect-[16/9] bg-gradient-to-br from-zinc-800 to-zinc-900 overflow-hidden">
    {imageUrl ? (
      <img
        src={imageUrl}
        alt={`${city} cityscape`}
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center">
        <svg class="w-16 h-16 text-zinc-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.75" d="M12 2l2.4 6.4H21l-5.5 4 2.1 6.4-5.6-4-5.6 4 2.1-6.4L3 8.4h6.6z" />
        </svg>
      </div>
    )}
    <div class="absolute bottom-0 left-0 right-0 h-12 bg-gradient-to-t from-zinc-900/80 to-transparent" aria-hidden="true"></div>
  </div>

  <div class="p-5">
    <h3 class="font-bold text-white text-lg leading-tight mb-1 group-hover:text-emerald-400 transition-colors">{name}</h3>

    <p class="text-zinc-500 text-sm mb-4">{stadium}</p>

    <div class="flex flex-wrap gap-2">
      <span class="badge bg-zinc-800 text-zinc-400 border border-zinc-700/50">
        <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        </svg>
        {city.charAt(0).toUpperCase() + city.slice(1)}
      </span>
      <span class="badge bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs">
        {leagueLabels[league] ?? league}
      </span>
    </div>

    <div class="mt-4 pt-4 border-t border-zinc-800 flex items-center justify-between">
      <span class="text-xs text-zinc-600">Cap. {stadiumCapacity.toLocaleString()}</span>
      <span class="text-emerald-400 text-sm font-medium group-hover:underline">Find hotels →</span>
    </div>
  </div>
</a>
