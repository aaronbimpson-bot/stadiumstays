---
interface Props {
  slug: string;
  name: string;
  stadium: string;
  city: string;
  league: string;
  stadiumCapacity: number;
  imageUrl?: string;
  imageAlt?: string;
  photographer?: string;
  photographerUsername?: string;
}

const { slug, name, stadium, city, league, stadiumCapacity, imageUrl, imageAlt, photographer, photographerUsername } = Astro.props;

const leagueLabels: Record<string, string> = {
  'premier-league':      'Premier League',
  'championship':        'Championship',
  'league-one':          'League One',
  'scottish-premiership':'Scottish Premiership',
  'la-liga':             'La Liga',
  'serie-a':             'Serie A',
};

// Gradient palette keyed by league slug
const gradients: Record<string, string> = {
  'premier-league':       'from-blue-900 via-blue-950 to-indigo-950',
  'championship':         'from-sky-900 via-sky-950 to-blue-950',
  'league-one':           'from-cyan-900 via-cyan-950 to-blue-950',
  'scottish-premiership': 'from-indigo-900 via-indigo-950 to-blue-950',
  'la-liga':              'from-red-900 via-rose-950 to-red-950',
  'serie-a':              'from-emerald-900 via-green-950 to-teal-950',
};
const gradient = gradients[league] ?? 'from-zinc-800 via-zinc-900 to-zinc-950';

const initial = name.charAt(0).toUpperCase();
const leagueLabel = leagueLabels[league] ?? league;
---

<!-- Card is a div to avoid invalid nested <a> elements. A stretched link covers the whole card.
     The photographer credit <a> sits above it (later in DOM = higher paint order). -->
<div class="card group hover:border-zinc-700 transition-all hover:-translate-y-0.5 relative">
  <!-- Stretched link — covers the entire card, sits below all other content -->
  <a href={`/clubs/${slug}/`} class="absolute inset-0 z-0" aria-label={`Find hotels near ${name}`}></a>

  <!-- Visual banner -->
  <div class={`relative aspect-[16/9] bg-gradient-to-br ${gradient} overflow-hidden`}>
    {imageUrl ? (
      <img
        src={`${imageUrl}&w=800&q=80`}
        alt={imageAlt ?? `${stadium}`}
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
      />
    ) : (
      <span
        class="absolute inset-0 flex items-center justify-center text-[9rem] font-black text-white/5 select-none leading-none"
        aria-hidden="true"
      >{initial}</span>
    )}
    <!-- Club name overlay -->
    <div class="absolute inset-0 flex flex-col items-start justify-end p-4 bg-gradient-to-t from-black/70 via-black/20 to-transparent">
      <span class="text-xs font-semibold tracking-widest uppercase text-white/60 mb-1">{leagueLabel}</span>
      <span class="text-xl font-bold text-white leading-tight">{name}</span>
    </div>
    {imageUrl && photographer && (
      <!-- Photographer credit — comes after the stretched link in DOM so it paints on top and is clickable -->
      <a
        href={`https://unsplash.com/@${photographerUsername}?utm_source=stadiumstays&utm_medium=referral`}
        target="_blank"
        rel="noopener noreferrer"
        class="absolute bottom-0 right-0 bg-black/50 text-white/60 text-[10px] px-2 py-0.5 hover:text-white transition-colors z-10"
        aria-label={`Photo by ${photographer} on Unsplash`}
      >
        {photographer} / Unsplash
      </a>
    )}
  </div>

  <div class="p-5">
    <h3 class="font-bold text-white text-lg leading-tight mb-1 group-hover:text-emerald-400 transition-colors">{name}</h3>

    <p class="text-zinc-500 text-sm mb-4">{stadium}</p>

    <div class="flex flex-wrap gap-2">
      <span class="badge bg-zinc-800 text-zinc-400 border border-zinc-700/50">
        <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        </svg>
        {city.charAt(0).toUpperCase() + city.slice(1)}
      </span>
      <span class="badge bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs">
        {leagueLabel}
      </span>
    </div>

    <div class="mt-4 pt-4 border-t border-zinc-800 flex items-center justify-between">
      <span class="text-xs text-zinc-600">Cap. {stadiumCapacity.toLocaleString()}</span>
      <span class="text-emerald-400 text-sm font-medium group-hover:underline">Find hotels →</span>
    </div>
  </div>
</div>
