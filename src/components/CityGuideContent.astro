---
/**
 * Shared city guide content sections.
 * Used by both /cities/[city]/ and /match/[slug]/ pages.
 */
import ClubCard from './ClubCard.astro';

interface Props {
  city: any;
  cityClubs: any[];
  unsplashImages: Record<string, any>;
}

const { city, cityClubs, unsplashImages } = Astro.props;
const c = city as any;
const hasRichContent = !!(c.intro || c.matchDayGuide || c.eatAndDrink || c.gettingAround);
---

<!-- ── City Intro ──────────────────────────────────────────────────── -->
{c.intro && (
  <section>
    <h2 class="text-2xl font-bold text-white mb-5">
      Why Football Fans Love {city.name}
    </h2>
    <div class="prose-custom">
      <p class="text-zinc-300 leading-relaxed text-[1.0625rem]">{c.intro}</p>
    </div>
  </section>
)}

<!-- ── Match Day Guide ─────────────────────────────────────────────── -->
{c.matchDayGuide && (
  <section>
    <h2 class="text-2xl font-bold text-white mb-5">
      Match Day in {city.name}
    </h2>
    <div class="card p-6 border-l-4 border-l-emerald-500">
      <p class="text-zinc-300 leading-relaxed text-[1.0625rem]">{c.matchDayGuide}</p>
    </div>
  </section>
)}

<!-- ── Clubs in city ───────────────────────────────────────────────── -->
{cityClubs.length > 0 && (
  <section>
    <h2 class="text-2xl font-bold text-white mb-6">
      Football Clubs in {city.name}
    </h2>
    <div class="grid sm:grid-cols-2 gap-4">
      {cityClubs.map((club: any) => {
        const img = unsplashImages[club.slug] ?? unsplashImages[city.slug];
        return (
          <ClubCard
            slug={club.slug}
            name={club.name}
            stadium={club.stadium}
            city={club.city}
            league={club.league}
            stadiumCapacity={club.stadiumCapacity}
            imageUrl={img?.url}
            imageAlt={img?.altDescription}
            photographer={img?.photographer}
            photographerUsername={img?.photographerUsername}
          />
        );
      })}
    </div>
  </section>
)}

<!-- ── Best Areas to Stay ─────────────────────────────────────────── -->
{city.bestAreas?.length > 0 && (
  <section>
    <h2 class="text-2xl font-bold text-white mb-2">Best Areas to Stay</h2>
    <p class="text-zinc-400 mb-6">Where to base yourself for the best matchday experience</p>
    <div class="space-y-4">
      {city.bestAreas.map((area: any, i: number) => (
        <div class="card p-5 flex gap-4">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center flex-shrink-0 text-emerald-400 text-sm font-bold">
            {i + 1}
          </div>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2 mb-1">
              <h3 class="font-semibold text-white">{area.name}</h3>
              {area.priceRange && (
                <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-400 border border-zinc-700">
                  {area.priceRange}
                </span>
              )}
              {area.distanceToStadium && (
                <span class="text-[11px] text-zinc-500">{area.distanceToStadium}</span>
              )}
            </div>
            <p class="text-zinc-400 text-sm leading-relaxed">{area.description}</p>
            {area.recommendation && (
              <p class="text-emerald-400 text-xs mt-2 font-medium">→ {area.recommendation}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
)}

<!-- ── Where to Eat & Drink ────────────────────────────────────────── -->
{c.eatAndDrink && (
  <section>
    <h2 class="text-2xl font-bold text-white mb-2">Where to Eat & Drink</h2>
    <p class="text-zinc-400 mb-6">Pre-match pubs, great restaurants, and post-match spots</p>

    <div class="space-y-8">

      {c.eatAndDrink.preMatchPubs?.length > 0 && (
        <div>
          <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 flex-shrink-0"></span>
            Pre-Match Pubs
          </h3>
          <div class="space-y-3">
            {c.eatAndDrink.preMatchPubs.map((pub: any) => (
              <div class="card p-4 flex gap-3">
                <div class="flex-1 min-w-0">
                  <div class="flex flex-wrap items-baseline gap-2">
                    <span class="font-semibold text-white text-sm">{pub.name}</span>
                    {pub.distance && <span class="text-zinc-600 text-xs">{pub.distance}</span>}
                  </div>
                  <p class="text-zinc-400 text-sm mt-0.5">{pub.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {c.eatAndDrink.restaurants?.length > 0 && (
        <div>
          <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-blue-400 flex-shrink-0"></span>
            Restaurants
          </h3>
          <div class="space-y-3">
            {c.eatAndDrink.restaurants.map((r: any) => (
              <div class="card p-4">
                <div class="flex flex-wrap items-baseline gap-2">
                  <span class="font-semibold text-white text-sm">{r.name}</span>
                  {(r.area || r.distance) && (
                    <span class="text-zinc-600 text-xs">{r.area ?? r.distance}</span>
                  )}
                </div>
                <p class="text-zinc-400 text-sm mt-0.5">{r.description}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      {c.eatAndDrink.postMatch?.length > 0 && (
        <div>
          <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-400 flex-shrink-0"></span>
            Post-Match
          </h3>
          <div class="space-y-3">
            {c.eatAndDrink.postMatch.map((v: any) => (
              <div class="card p-4">
                <div class="flex flex-wrap items-baseline gap-2">
                  <span class="font-semibold text-white text-sm">{v.name}</span>
                  {(v.area || v.distance) && (
                    <span class="text-zinc-600 text-xs">{v.area ?? v.distance}</span>
                  )}
                </div>
                <p class="text-zinc-400 text-sm mt-0.5">{v.description}</p>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
)}

<!-- ── Getting Around ──────────────────────────────────────────────── -->
{c.gettingAround && (
  <section>
    <h2 class="text-2xl font-bold text-white mb-6">Getting Around {city.name}</h2>
    <div class="grid sm:grid-cols-2 gap-4">
      {c.gettingAround.fromAirport && (
        <div class="card p-5">
          <h3 class="font-semibold text-white mb-2 flex items-center gap-2 text-sm">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
            </svg>
            From the Airport
          </h3>
          <p class="text-zinc-400 text-sm leading-relaxed">{c.gettingAround.fromAirport}</p>
        </div>
      )}
      {c.gettingAround.fromStation && (
        <div class="card p-5">
          <h3 class="font-semibold text-white mb-2 flex items-center gap-2 text-sm">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
            </svg>
            By Train
          </h3>
          <p class="text-zinc-400 text-sm leading-relaxed">{c.gettingAround.fromStation}</p>
        </div>
      )}
      {c.gettingAround.betweenStadiums && (
        <div class="card p-5">
          <h3 class="font-semibold text-white mb-2 flex items-center gap-2 text-sm">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/>
            </svg>
            Between Stadiums
          </h3>
          <p class="text-zinc-400 text-sm leading-relaxed">{c.gettingAround.betweenStadiums}</p>
        </div>
      )}
      {c.gettingAround.localTransport && (
        <div class="card p-5">
          <h3 class="font-semibold text-white mb-2 flex items-center gap-2 text-sm">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
            </svg>
            Local Transport
          </h3>
          <p class="text-zinc-400 text-sm leading-relaxed">{c.gettingAround.localTransport}</p>
        </div>
      )}
    </div>
  </section>
)}

<!-- ── Beyond the Football ────────────────────────────────────────── -->
{c.beyondFootball?.length > 0 && (
  <section>
    <h2 class="text-2xl font-bold text-white mb-2">Beyond the Football</h2>
    <p class="text-zinc-400 mb-6">What to do if you're making a weekend of it</p>
    <div class="space-y-3">
      {c.beyondFootball.map((item: any, i: number) => (
        <div class="card p-5 flex gap-4">
          <div class="w-7 h-7 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center flex-shrink-0 text-zinc-400 text-xs font-bold">
            {i + 1}
          </div>
          <div class="min-w-0">
            <h3 class="font-semibold text-white text-sm mb-1">{item.name}</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
)}

<!-- ── Insider Tips ────────────────────────────────────────────────── -->
{c.insiderTips?.length > 0 && (
  <section>
    <h2 class="text-2xl font-bold text-white mb-6">Insider Tips</h2>
    <div class="card p-6">
      <ul class="space-y-4">
        {c.insiderTips.map((tip: string) => (
          <li class="flex gap-3">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p class="text-zinc-300 text-sm leading-relaxed">{tip}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<!-- ── Highlights (fallback for cities without rich content) ─────── -->
{!hasRichContent && city.highlights?.length > 0 && (
  <section>
    <h2 class="text-xl font-bold text-white mb-6">City Highlights</h2>
    <div class="flex flex-wrap gap-3">
      {city.highlights.map((highlight: string) => (
        <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-300 text-sm max-w-full">
          <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span class="break-words">{highlight}</span>
        </div>
      ))}
    </div>
  </section>
)}
